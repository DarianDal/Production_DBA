--24. Query that lists a snapshot of active connections to the specified database
SELECT
    c.session_id,
    s.login_name,
    s.host_name,
    c.client_net_address,
    c.connect_time, 
	d.name
FROM
    sys.dm_exec_connections AS c
JOIN
    sys.dm_exec_sessions AS s ON c.session_id = s.session_id
JOIN
	sys.databases AS d ON d.database_id = s.database_id
WHERE
	name = '[SourceDatabaseName]';



--25. This script will write a copy only backup with overwrite to a specified backup path, my personal folder on the share drive in this case, and append today's date and time to it. 
DECLARE @DatabaseName AS NVARCHAR(128);
DECLARE @BackupPath AS NVARCHAR(256);
DECLARE @FileName AS NVARCHAR(256);
DECLARE @BackupFullPath AS NVARCHAR(512);
DECLARE @BackupCommand AS NVARCHAR(MAX);

-- Set the database name you want to back up
SET @DatabaseName = N'[SourceDatabaseName]'; -- Replace 'YourDatabaseName' with your actual database name

-- Set the base path for your backups
SET @BackupPath = N'\\Destination\'; -- Replace with your desired backup directory

-- Construct the dynamic file name including date and time
SET @FileName = @DatabaseName + N'_' + 
                CONVERT(NVARCHAR(8), GETDATE(), 112) + -- YYYYMMDD
                N'_' + 
                REPLACE(CONVERT(NVARCHAR(8), GETDATE(), 108), ':', '') + -- HHMMSS
                N'.bak';

-- Combine the path and file name
SET @BackupFullPath = @BackupPath + @FileName;

-- Construct the full BACKUP DATABASE command
SET @BackupCommand = N'BACKUP DATABASE ' + @DatabaseName + N' TO DISK = N''' + @BackupFullPath + N''' WITH COPY_ONLY, NOFORMAT, INIT, NAME = N''' + @DatabaseName + N'-Full Database Backup'', SKIP, NOREWIND, NOUNLOAD, STATS = 10;';

-- Print the command (optional, for verification)
PRINT @BackupCommand;

-- Execute the backup command
EXECUTE sp_executesql @BackupCommand;

--Script that writes an ALTER DATABASE statement to update the compatibility level for all databases on a server
--and changes the dbowner to sa

DECLARE @command NVARCHAR(MAX);

-- The '?' acts as a placeholder for the database name
SET @command = '
USE [?];
IF DB_NAME() NOT IN (''master'', ''model'', ''msdb'', ''tempdb'')
BEGIN
  DECLARE @DataLogicName NVARCHAR(255), @LogLogicName NVARCHAR(255);
	DECLARE @AppendTodaysDate NVARCHAR(25);
	DECLARE @CompatibilityLevel INT;
  DECLARE @TODAYSDATE DATE = GETDATE();
    
  -- Retrieve the logical names for the primary data and log files
  SELECT @DataLogicName = name FROM sys.database_files WHERE type = 0;
  SELECT @LogLogicName = name FROM sys.database_files WHERE type = 1;
    
	SET @CompatibilityLevel = CAST(LEFT(CAST(SERVERPROPERTY(''ProductVersion'') AS NVARCHAR(25)), 
                            CHARINDEX(''.'', CAST(SERVERPROPERTY(''ProductVersion'') AS NVARCHAR(25))) - 1) AS INT) * 10;
	SET @AppendTodaysDate = REPLACE(CONVERT(NVARCHAR(25), @TODAYSDATE, 110), ''-'', '''');

  print 
''
USE [?] 
GO
EXEC sp_changedbowner ''''sa'''';
ALTER DATABASE [?] SET COMPATIBILITY_LEVEL = '' + CAST(@CompatibilityLevel AS NVARCHAR(3)) + '';
GO
''

END';

EXEC sp_MSforeachdb @command;
